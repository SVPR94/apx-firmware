<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="windsock">
    <static>false</static>

    <!-- Base Pole anchored to ground -->
    <link name="base_pole">
      <inertial>
        <mass>25.0</mass>
        <inertia>
          <ixx>27.0</ixx>
          <iyy>27.0</iyy>
          <izz>0.08</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <!-- Base plate -->
      <visual name="base_plate_visual">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.25</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.25 0.25 0.25 1.0</ambient>
          <diffuse>0.35 0.35 0.35 1.0</diffuse>
          <pbr>
            <metal>
              <roughness>0.7</roughness>
              <metalness>0.3</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <!-- Vertical mast (3.6m tall) -->
      <visual name="mast_visual">
        <pose>0 0 1.8 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>3.6</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1.0</ambient>
          <diffuse>0.45 0.45 0.45 1.0</diffuse>
          <pbr>
            <metal>
              <roughness>0.5</roughness>
              <metalness>0.4</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <collision name="mast_collision">
        <pose>0 0 1.8 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.06</radius>
            <length>3.6</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="windsock_world_mount" type="fixed">
      <parent>world</parent>
      <child>base_pole</child>
    </joint>

    <!-- Swivel head: yaw axis around Z at top of mast -->
    <link name="yaw_head">
      <!-- Posed by apx_gazebo_plugin at 30 Hz; without gravity it holds
           that pose between updates instead of sagging. -->
      <gravity>false</gravity>
      <pose>0 0 3.6 0 0 0</pose>
      <inertial>
        <mass>1.2</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.02</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <!-- Pivot collar -->
      <visual name="swivel_collar_visual">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.065</radius>
            <length>0.12</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1.0</ambient>
          <diffuse>0.25 0.25 0.25 1.0</diffuse>
        </material>
      </visual>
      <!-- Support arm extending to mouth hoop -->
      <visual name="arm_visual">
        <pose>0.12 0 0.06 0 0 0</pose>
        <geometry>
          <box>
            <size>0.24 0.035 0.035</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1.0</ambient>
          <diffuse>0.25 0.25 0.25 1.0</diffuse>
        </material>
      </visual>
      <!-- Mouth ring / hoop -->
      <visual name="hoop_visual">
        <pose>0.24 0 0.06 0 1.5707963 0</pose>
        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1.0</ambient>
          <diffuse>0.4 0.4 0.4 1.0</diffuse>
        </material>
      </visual>
    </link>

    <joint name="windsock_yaw_joint" type="revolute">
      <parent>base_pole</parent>
      <child>yaw_head</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14159265</lower>
          <upper>3.14159265</upper>
        </limit>
      </axis>
    </joint>

    <!-- Cone sock: hinges at mouth ring and extends downwind (+X in local frame) -->
    <link name="sock_body">
      <!-- Posed by apx_gazebo_plugin at 30 Hz; without gravity it holds
           that pose between updates instead of sagging. -->
      <gravity>false</gravity>
      <pose>0.24 0 3.66 0 0 0</pose>
      <inertial>
        <mass>0.6</mass>
        <pose>0.65 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.015</ixx>
          <iyy>0.12</iyy>
          <izz>0.12</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Band 1: Orange (Mouth) [0.00 to 0.30m] -->
      <visual name="band1_orange">
        <pose>0.15 0 0 0 1.5707963 0</pose>
        <geometry>
          <cylinder>
            <radius>0.20</radius>
            <length>0.30</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.9 0.30 0.0 1.0</ambient>
          <diffuse>1.0 0.38 0.0 1.0</diffuse>
        </material>
      </visual>

      <!-- Band 2: White [0.30 to 0.60m] -->
      <visual name="band2_white">
        <pose>0.45 0 0 0 1.5707963 0</pose>
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>0.30</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.85 0.85 0.85 1.0</ambient>
          <diffuse>0.95 0.95 0.95 1.0</diffuse>
        </material>
      </visual>

      <!-- Band 3: Orange [0.60 to 0.90m] -->
      <visual name="band3_orange">
        <pose>0.75 0 0 0 1.5707963 0</pose>
        <geometry>
          <cylinder>
            <radius>0.16</radius>
            <length>0.30</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.9 0.30 0.0 1.0</ambient>
          <diffuse>1.0 0.38 0.0 1.0</diffuse>
        </material>
      </visual>

      <!-- Band 4: White [0.90 to 1.20m] -->
      <visual name="band4_white">
        <pose>1.05 0 0 0 1.5707963 0</pose>
        <geometry>
          <cylinder>
            <radius>0.14</radius>
            <length>0.30</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.85 0.85 0.85 1.0</ambient>
          <diffuse>0.95 0.95 0.95 1.0</diffuse>
        </material>
      </visual>

      <!-- Band 5: Orange (Tail) [1.20 to 1.50m] -->
      <visual name="band5_orange">
        <pose>1.35 0 0 0 1.5707963 0</pose>
        <geometry>
          <cylinder>
            <radius>0.12</radius>
            <length>0.30</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.9 0.30 0.0 1.0</ambient>
          <diffuse>1.0 0.38 0.0 1.0</diffuse>
        </material>
      </visual>
    </link>

    <!-- Pitch joint: tilts downwards when calm, lifts horizontal when windy -->
    <joint name="windsock_pitch_joint" type="revolute">
      <parent>yaw_head</parent>
      <child>sock_body</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.25</lower>
          <upper>1.40</upper>
        </limit>
      </axis>
    </joint>
  </model>
</sdf>
