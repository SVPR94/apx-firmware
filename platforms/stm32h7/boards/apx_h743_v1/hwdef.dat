# APX Hardware Definition for apx_h743_v1 (STM32H743)
# Microcontroller configuration
MCU STM32H743xx
FLASH_SIZE 2048
RAM_SIZE 1024
OSCILLATOR_HZ 25000000

# IMU: ICM-42688 on SPI1
PA4 SPI1_NSS SPI1
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1
PC4 IMU_EXTI
SPIDEV icm42688 SPI1 PA4 MODE3 10*MHZ

# Magnetometer: IST8310 & Power Monitor INA226 on I2C1
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1
I2CDEV ist8310 I2C1 0x0E
I2CDEV ina226 I2C1 0x40

# GPS on USART1
PA9 USART1_TX USART1
PA10 USART1_RX USART1
UART 1 PA9 PA10 115200 GPS

# Telemetry on USART2
PA2 USART2_TX USART2
PA3 USART2_RX USART2
UART 2 PA2 PA3 57600 TELEM

# RC Input (SBUS) on USART3
PB10 USART3_TX USART3
PB11 USART3_RX USART3
UART 3 PB10 PB11 100000 RC

# Motors (TIM1 PWM Outputs)
PE9 TIM1_CH1 TIM1 PWM(1)
PE11 TIM1_CH2 TIM1 PWM(2)
PE13 TIM1_CH3 TIM1 PWM(3)
PE14 TIM1_CH4 TIM1 PWM(4)
MOTOR 1 1 1 PE9
MOTOR 2 1 2 PE11
MOTOR 3 1 3 PE13
MOTOR 4 1 4 PE14

# Status LED
PC13 LED1 ACTIVE_LOW
LED 1 PC13 ACTIVE_LOW
