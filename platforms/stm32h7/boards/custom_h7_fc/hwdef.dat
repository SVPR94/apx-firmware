# APX Hardware Definition: Custom STM32H7 Flight Controller
# Microcontroller configuration
MCU STM32H743xx
FLASH_SIZE 2048
RAM_SIZE 1024
OSCILLATOR_HZ 25000000

# Primary IMU: ICM-42688 on SPI1
PA4 SPI1_NSS SPI1
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1
PC4 IMU_EXTI
SPIDEV icm42688 SPI1 PA4 MODE3 10*MHZ

# Magnetometer & Power Monitor on I2C1
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1
I2CDEV ist8310 I2C1 0x0E
I2CDEV ina226 I2C1 0x40

# Barometer on I2C2
PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2
I2CDEV ms5611 I2C2 0x77

# GPS UART (USART1)
PA9 USART1_TX USART1
PA10 USART1_RX USART1
UART 1 PA9 PA10 115200 GPS

# Telemetry UART (USART2)
PA2 USART2_TX USART2
PA3 USART2_RX USART2
UART 2 PA2 PA3 57600 TELEM

# RC Input UART (USART3)
PD8 USART3_TX USART3
PD9 USART3_RX USART3
UART 3 PD8 PD9 100000 RC

# ESC Telemetry UART (UART4)
PC10 UART4_TX UART4
PC11 UART4_RX UART4
UART 4 PC10 PC11 115200 ESC_TELEM

# Motor Outputs 1-4 (TIM1)
PE9 TIM1_CH1 TIM1 PWM(1)
PE11 TIM1_CH2 TIM1 PWM(2)
PE13 TIM1_CH3 TIM1 PWM(3)
PE14 TIM1_CH4 TIM1 PWM(4)
MOTOR 1 1 1 PE9
MOTOR 2 1 2 PE11
MOTOR 3 1 3 PE13
MOTOR 4 1 4 PE14

# Auxiliary Servos 9-10 for Payloads/Sprayers (TIM4)
PD12 TIM4_CH1 TIM4 PWM(9)
PD13 TIM4_CH2 TIM4 PWM(10)
SERVO 9 4 1 PD12
SERVO 10 4 2 PD13

# Status Indicators
PC13 LED1 ACTIVE_LOW
PC14 LED2 ACTIVE_LOW
LED 1 PC13 ACTIVE_LOW
LED 2 PC14 ACTIVE_LOW

# Actuators & Relays
PE3 RELAY1
PE4 RELAY2
RELAY 1 PE3
RELAY 2 PE4
