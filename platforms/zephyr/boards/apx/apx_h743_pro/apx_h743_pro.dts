 * Author: Savita Pawar (SVPR94)
 * Created: 2026
 *
 * APX H743 Pro flight controller (STM32H743, Cortex-M7 at 400 MHz).
 *
 * Pins from platforms/stm32h7/boards/apx_h743_pro/hwdef.dat: 24 MHz crystal,
 * 128 KB bootloader at the start of flash (.apj board id 22336), USB OTG FS
 * on PA11/PA12 as the GCS link, STM32F103 IO MCU on USART6 (MAIN 1-8, RC
 * input, safety switch; pin map in iomcu.dat). The same board without an IO
 * MCU is the APX H743 v1.
 */
/dts-v1/;
#include <st/h7/stm32h743Xi.dtsi>
#include <st/h7/stm32h743xihx-pinctrl.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	model = "APX H743 Pro (STM32H743)";
	compatible = "apx,apx-h743-pro";

	chosen {
		zephyr,sram = &sram0;
		zephyr,dtcm = &dtcm;
		zephyr,flash = &flash0;
		zephyr,code-partition = &app_partition;
		apx,gcs-uart = &cdc_acm_uart0;
		apx,iomcu-uart = &usart6;
	};

	leds {
		compatible = "gpio-leds";
		led_activity: led_activity {
			gpios = <&gpiob 3 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
			label = "Activity LED (red)";
		};
		led_bootloader: led_bootloader {
			gpios = <&gpioe 12 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
			label = "Bootloader LED (blue)";
		};
		led_status: led_status {
			gpios = <&gpioe 10 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
			label = "Status LED (green)";
		};
	};

	aliases {
		led0 = &led_activity;
	};

	/* APX board properties - see platforms/zephyr/app/src/board_zephyr.cpp */
	zephyr,user {
		/* Switched on in this order: peripheral 5V (GPS / telemetry
		 * ports), high-power 5V, then the sensor 3V3 rail. */
		power-enable-gpios = <&gpiog 4 GPIO_ACTIVE_LOW>,
				     <&gpiog 5 GPIO_ACTIVE_LOW>,
				     <&gpioe 3 GPIO_ACTIVE_HIGH>;
		power-enable-delay-ms = <20>;
		apj-board-id = <22336>;
	};

	/* APX boot control: application <-> bootloader handshake across a
	 * reset (bootloader/include/apx/bootloader/boot_control.hpp). The last
	 * 1 KB of DTCM, outside both images' RAM (&dtcm is shrunk below) and
	 * never cached. */
	apx_boot_control: boot-control@2001fc00 {
		reg = <0x2001fc00 DT_SIZE_K(1)>;
	};
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(24)>;
	status = "okay";
};

/* USB 48 MHz */
&clk_hsi48 {
	status = "okay";
};

/* 24 MHz / 3 = 8 MHz PLL input, * 100 = 800 MHz VCO, / 2 = 400 MHz SYSCLK (VOS1) */
&pll {
	div-m = <3>;
	mul-n = <100>;
	div-p = <2>;
	div-q = <10>;
	div-r = <2>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(400)>;
	d1cpre = <1>;
	hpre = <2>;
	d1ppre = <2>;
	d2ppre1 = <2>;
	d2ppre2 = <2>;
	d3ppre = <2>;
};

/* STM32H743: internal LDO core supply (no SMPS on this part). */
&pwr {
	power-supply = "ldo";
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* Bootloader - never written by APX */
		bootloader_partition: partition@0 {
			label = "bootloader";
			reg = <0x00000000 DT_SIZE_K(128)>;
			read-only;
		};
		/* APX firmware: the bootloader jumps to 0x08020000 */
		app_partition: partition@20000 {
			label = "apx-firmware";
			reg = <0x00020000 DT_SIZE_K(896)>;
		};
	};
};

zephyr_udc0: &usbotg_fs {
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "APX MAVLink";
	};
};

/* IO MCU link: register protocol at 1.5 Mbaud (drivers/iomcu) */
&usart6 {
	pinctrl-0 = <&usart6_tx_pc6 &usart6_rx_pc7>;
	pinctrl-names = "default";
	current-speed = <1500000>;
	fifo-enable;
	status = "okay";
};

/* Last 1 KB of DTCM reserved for apx_boot_control. */
&dtcm {
	reg = <0x20000000 DT_SIZE_K(127)>;
};
