# Sysbuild options for the APX flight firmware (west build --sysbuild).

config APX_BOOTLOADER
	bool "Build the APX bootloader and a combined bootloader + firmware image"
	default y
	help
	  Builds platforms/zephyr/bootloader together with the firmware and
	  packages build/<dir>/firmware/: bootloader, firmware, .apj and the
	  combined image to flash once over SWD. Boards that keep a stock
	  bootloader can still build it; flashing it is optional.

source "share/sysbuild/Kconfig"
